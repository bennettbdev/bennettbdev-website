---
import type { CollectionEntry } from "astro:content";
import PostList from "@/components/blog/PostList.astro";
import { getAllPosts, getUniqueTagsWithCount, sortMDByDate } from "@/data/post";
import { withBase } from "@/utils/path";

import PageLayout from "@/layouts/Base.astro";
import type { GetStaticPaths, Page } from "astro";

// Posts are fetched once in getStaticPaths and passed through `props`
// The frontmatter body can't share module-scope variables with getStaticPaths
export const getStaticPaths = (async ({ paginate }) => {
	const POSTS_PER_PAGE = 10;
	const allPostsByDate = sortMDByDate(await getAllPosts());
	return paginate(allPostsByDate, {
		pageSize: POSTS_PER_PAGE,
		props: { allPosts: allPostsByDate },
	});
}) satisfies GetStaticPaths;

interface Props {
	allPosts: CollectionEntry<"post">[];
	page: Page<CollectionEntry<"post">>;
}

const { allPosts, page } = Astro.props;

const tags = getUniqueTagsWithCount(allPosts);

const meta = {
	description: "Read my collection of posts and the things that interest me",
	title: page.currentPage > 1 ? `Posts — Page ${page.currentPage}` : "Posts",
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: "← Previous",
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: "Next →",
			url: page.url.next,
		},
	}),
};

const totalCount = page.total;
---

<PageLayout meta={meta}>
	<section class="writing" aria-labelledby="writing-label">
		<div class="section-label" id="writing-label">{totalCount} posts</div>
		<div class="tag-list">
			<ul class="tag-run">
				{
					tags.map(([tag, count]) => (
						<li>
							<a data-astro-prefetch href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>
								<span class="name">{tag}</span>
								<span class="count">{count}</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<div class="timeline">
			<PostList posts={page.data} />
		</div>
		{
			(paginationProps.prevUrl || paginationProps.nextUrl) && (
				<nav class="pagination" aria-label="Pagination">
					{paginationProps.prevUrl && (
						<a class="pag-link prev" data-astro-prefetch href={paginationProps.prevUrl.url}>
							{paginationProps.prevUrl.text}
						</a>
					)}
					{paginationProps.nextUrl && (
						<a class="pag-link next" data-astro-prefetch href={paginationProps.nextUrl.url}>
							{paginationProps.nextUrl.text}
						</a>
					)}
				</nav>
			)
		}
	</section>
</PageLayout>

<style>
	.writing {
		margin-bottom: 96px;
	}

	#writing-label {
		margin-bottom: 24px;
	}

	.tag-list {
		margin-bottom: 24px;
		padding-bottom: 24px;
		border-bottom: 1px solid var(--hairline);
	}

	.tag-run {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		font-family: var(--font-code);
	}

	.tag-run a {
		display: inline-flex;
		align-items: baseline;
		gap: 5px;
		text-decoration: none;
		color: var(--theme-accent);
		font-size: 14.5px;
		letter-spacing: 0.01em;
		transition: color 0.2s ease;
		border-radius: var(--button-border-radius);
		border: 1px solid var(--hairline);
		padding: 4px;
	}
	.tag-run .name::before {
		content: "#";
		color: var(--faint);
		transition: color 0.2s ease;
		margin-right: 2px;
	}
	.tag-run a:hover {
		color: hsl(var(--theme-accent));
	}
	.tag-run a:hover .name::before {
		color: hsl(var(--theme-accent));
	}
	.tag-run a:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
		border-radius: 3px;
	}
	.tag-run .count {
		font-size: 11px;
		color: hsl(var(--theme-text) / 0.4);
		font-variant-numeric: tabular-nums;
		font-feature-settings: "tnum";
	}
	.tag-run a:hover .count {
		color: hsl(var(--theme-accent) / 0.7);
	}

	.pagination {
		grid-column: 2;
		margin-top: 8px;
		display: flex;
		gap: 24px;
		align-items: center;
		justify-content: space-between;
	}
	.pag-link {
		display: inline-block;
		padding: 8px 4px;
		font-family: var(--font-code);
		font-size: 11.5px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: hsl(var(--theme-text-muted));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition:
			color 0.2s ease,
			text-decoration-color 0.2s ease;
	}
	.pag-link.prev {
		margin-right: auto;
	}
	.pag-link.next {
		margin-left: auto;
	}
	.pag-link:hover {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}
	.pag-link:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
		border-radius: 3px;
	}

	@media (max-width: 720px) {
		.pagination {
			margin-top: 16px;
		}
	}

	@media (max-width: 420px) {
		.writing {
			margin-bottom: 64px;
		}
	}
</style>
