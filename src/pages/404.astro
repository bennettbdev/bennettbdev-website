---
import PageLayout from "@/layouts/Base.astro";
import { withBase } from "@/utils/path";

const meta = {
	description: "The page you were looking for doesn't exist.",
	title: "404 — Not found",
};
---

<PageLayout meta={meta}>
	<section class="not-found">
		<div class="eyebrow">Error • 404</div>
		<h1>Page not found.</h1>
		<p>
			The page you were looking for doesn't exist. It may have been moved, renamed, or just isn't
			there yet. Try the <a href={withBase("/")}>home</a> page, or browse the
			<a href={withBase("/posts/")}>posts</a> page.
		</p>
	</section>
</PageLayout>

<style>
	.not-found {
		padding-top: 24px;
		padding-bottom: 80px;
	}
	.eyebrow {
		font-family: var(--font-code);
		font-size: 11.5px;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: hsl(var(--theme-text-muted));
		margin-bottom: 24px;
	}
	.not-found h1 {
		font-family: var(--font-main);
		font-weight: 500;
		font-size: clamp(32px, 5vw, 44px);
		letter-spacing: -0.02em;
		line-height: 1.12;
		color: hsl(var(--theme-text));
		margin: 0 0 18px;
		max-width: 48ch;
	}
	.not-found p {
		font-size: 17.5px;
		line-height: 1.7;
		color: hsl(var(--theme-text));
		margin: 0;
	}
	.not-found a {
		color: hsl(var(--theme-accent));
		border-bottom: 1px solid hsl(var(--theme-accent) / 0.4);
		padding-bottom: 1px;
		transition: border-color 0.2s ease;
	}
	.not-found a:hover {
		border-color: hsl(var(--theme-accent));
	}
</style>
