<button class="theme-btn" id="theme-toggle" type="button" aria-label="Toggle theme">
	<span class="icon" aria-hidden="true"></span>
</button>

<style is:global>
	.theme-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 35px;
		height: 35px;
		border: 1px solid var(--hairline);
		border-radius: var(--button-border-radius);
		background: transparent;
		color: hsl(var(--theme-text));
		cursor: pointer;
		transition:
			color 0.2s ease,
			background-color 0.2s ease,
			border-color 0.2s ease;
	}
	.theme-btn:hover {
		color: hsl(var(--theme-accent));
		border-color: hsl(var(--theme-accent));
		background: var(--accent-soft);
	}
	.theme-btn:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 2px;
	}
	.theme-btn .icon::before {
		content: "☾";
		font-size: 19px;
		line-height: 1;
	}
	[data-theme="dark"] .theme-btn .icon::before {
		content: "☀";
	}
</style>

<script>
	const r = document.documentElement;
	const btn = document.getElementById("theme-toggle") as HTMLButtonElement | null;
	if (btn) {
		btn.addEventListener("click", () => {
			const next = r.dataset.theme === "dark" ? "light" : "dark";
			r.dataset.theme = next;
			try {
				localStorage.setItem("theme", next);
			} catch {}
			document.dispatchEvent(new CustomEvent("theme-change", { detail: { theme: next } }));
		});
	}
</script>
