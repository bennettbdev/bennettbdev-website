---
import { siteConfig } from "@/site-config";
import { withBase } from "@/utils/path";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="left">
		<span>&copy; {year} {siteConfig.title}</span>
		{
			!siteConfig.hideThemeCredit && (
				<span class="theme-credit">
					Powered by{" "}
					<a href="https://astro.build/" rel="noopener">
						Astro
					</a>
				</span>
			)
		}
	</div>
	<div class="right">
		<a href="https://github.com/bennettbdev">Github</a>
		<span class="sep" aria-hidden="true">•</span>
		<a href={withBase("/rss.xml")}>RSS</a>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--hairline);
		padding: 22px max(32px, env(safe-area-inset-right)) 0 max(32px, env(safe-area-inset-left));
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 16px;
		font-family: var(--font-navigate);
		font-size: 12.5px;
		color: hsl(var(--theme-text) / 0.72);
		transition: border-color 0.35s ease;
	}
	.site-footer .left {
		display: flex;
		gap: 18px;
		align-items: center;
		flex-wrap: wrap;
	}
	.site-footer .theme-credit {
		font-size: 11.5px;
		color: hsl(var(--theme-text) / 0.55);
	}
	.site-footer .theme-credit a {
		color: inherit;
		border-bottom: 1px dotted hsl(var(--theme-text) / 0.35);
	}
	.site-footer .theme-credit a:hover {
		color: hsl(var(--theme-accent));
		border-bottom-color: currentColor;
	}
	.site-footer .right {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.site-footer .right .sep {
		color: var(--faint);
	}
	.site-footer a {
		color: hsl(var(--theme-text-muted));
		transition: color 0.2s ease;
	}
	.site-footer a:hover {
		color: hsl(var(--theme-accent));
	}

	@media (max-width: 720px) {
		.site-footer {
			padding: 22px max(22px, env(safe-area-inset-right)) 0 max(22px, env(safe-area-inset-left));
		}
	}

	@media (max-width: 420px) {
		.site-footer {
			font-size: 11.5px;
			gap: 12px;
			padding: 22px max(16px, env(safe-area-inset-right)) 0 max(16px, env(safe-area-inset-left));
		}
	}
</style>
