---
import type { CollectionEntry } from "astro:content";
import { getPostSortDate } from "@/data/post";
import { formatRailDate } from "@/utils/date";
import { withBase } from "@/utils/path";

interface Props {
	posts: CollectionEntry<"post">[];
	/** Heading tag for each post title. */
	headingLevel?: "h2" | "h3";
}

const { posts, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
---

{
	posts.map((p) => (
		<a class="post" data-astro-prefetch href={withBase(`/posts/${p.id}/`)}>
			<div class="post-rail">
				<time class="post-date" datetime={getPostSortDate(p).toISOString()}>
					{formatRailDate(getPostSortDate(p))}
				</time>
				<span class="post-dot" aria-hidden="true" />
			</div>
			<div class="post-body">
				<Heading class="post-title">{p.data.title}</Heading>
				<p class="post-preview">{p.data.description}</p>
			</div>
		</a>
	))
}
