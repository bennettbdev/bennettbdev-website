---
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { siteConfig } from "@/site-config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
} = Astro.props;
---

<html class="scroll-smooth" lang={siteConfig.lang}>
	<head>
		<ThemeProvider />
		<BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />
		{
			siteConfig.pagefind !== false && (
				<>
					<link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
					<script is:inline src="/pagefind/pagefind-component-ui.js"></script>
					<style is:inline>
						:root {
							--pf-text: hsl(var(--theme-text));
							--pf-text-secondary: hsl(var(--theme-text-muted));
							--pf-text-muted: hsl(var(--theme-text-muted));
							--pf-background: hsl(var(--theme-bg));
							--pf-border: var(--hairline);
							--pf-border-focus: hsl(var(--theme-accent));
							--pf-skeleton: var(--hairline);
							--pf-skeleton-shine: var(--accent-soft);
							--pf-hover: var(--accent-soft);
							--pf-mark: hsl(var(--theme-accent));
							--pf-outline-focus: hsl(var(--theme-accent));
							--pf-font: var(--font-main);
							--pf-input-height: 40px;
							--pf-input-font-size: 16px;
							--pf-border-radius: 4px;
							--pf-modal-max-width: 560px;
							--pf-scroll-shadow: rgba(0, 0, 0, 0.08);
							--pf-shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
							--pf-shadow-md: 0 4px 12px rgba(0, 0, 0, 0.1);
							--pf-shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.2);
							--pf-modal-backdrop: rgba(0, 0, 0, 0.5);
						}
						:root[data-theme="dark"] {
							--pf-scroll-shadow: rgba(255, 255, 255, 0.08);
							--pf-shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.3);
							--pf-shadow-md: 0 4px 12px rgba(0, 0, 0, 0.4);
							--pf-shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.5);
							--pf-modal-backdrop: rgba(0, 0, 0, 0.7);
						}
					</style>
				</>
			)
		}
	</head>
	<body>
		<SkipLink />
		<Header />
		{
			siteConfig.pagefind !== false && (
				<pagefind-modal reset-on-close></pagefind-modal>
			)
		}
		<div class="wrap">
			<main id="main">
				<slot />
			</main>
			<Footer />
		</div>

		<style is:global>
			html {
				scrollbar-gutter: stable;
			}
			html,
			body {
				margin: 0;
				padding: 0;
			}
			body {
				overflow-x: hidden;
			}
			body {
				background-color: hsl(var(--theme-bg));
				color: hsl(var(--theme-text));
				font-family: var(--font-main);
				font-size: 18px;
				line-height: 1.62;
				font-weight: 400;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				text-rendering: optimizeLegibility;
				min-height: 100vh;
				min-height: 100dvh;
			}
			html.theme-ready body {
				transition:
					background-color 0.35s ease,
					color 0.35s ease;
			}
			a {
				color: inherit;
				text-decoration: none;
				transition:
					color 0.2s ease,
					border-color 0.2s ease;
			}

			/* Sticky footer: wrap fills viewport, main grows to push footer down */
			.wrap {
				max-width: var(--layout-max);
				margin: 0 auto;
				padding: 24px 0 max(80px, env(safe-area-inset-bottom)) 0;
				min-height: 100vh;
				min-height: 100dvh;
				display: flex;
				flex-direction: column;
			}
			.wrap > main {
				flex: 1 0 auto;
			}

			@media (max-width: 720px) {
				.wrap {
					padding: 14px 0 max(56px, env(safe-area-inset-bottom)) 0;
				}
				body {
					font-size: 17px;
				}
			}

			@media (max-width: 420px) {
				.wrap {
					padding: 10px 0 max(44px, env(safe-area-inset-bottom)) 0;
				}
				body {
					font-size: 16.5px;
				}
			}
		</style>
	</body>
</html>
