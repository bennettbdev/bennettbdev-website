{
	"name": "bennettbdev-website",
	"version": "0.1.0",
	"description": "Custom Astro blog for Bennett B.",
	"license": "GPL-3.0-only",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro check && astro build",
		"postbuild": "pagefind --site dist",
		"preview": "astro preview",
		"lint": "biome lint .",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check",
		"social-card": "tsx scripts/generate-social-card.ts"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.2.1",
		"@astrojs/mdx": "7.0.4",
		"@astrojs/partytown": "^2.1.7",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@playform/compress": "^0.2.3",
		"astro": "7.1.4",
		"astro-expressive-code": "^0.44.1",
		"astro-icon": "^1.1.5",
		"astro-robots-txt": "^1.0.0",
		"astro-seo-schema": "^7.0.0",
		"astro-webmanifest": "^1.0.0",
		"github-slugger": "^2.0.0",
		"hastscript": "^9.0.1",
		"katex": "^0.18.1",
		"mdast-util-directive": "^3.1.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"rehype-external-links": "^3.0.0",
		"rehype-katex": "^7.0.1",
		"remark-directive": "^4.0.0",
		"remark-math": "^6.0.0",
		"satori": "0.29.0",
		"satori-html": "^0.3.2",
		"schema-dts": "^1.1.5",
		"sharp": "^0.35.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.6",
		"@iconify-json/mdi": "^1.2.3",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/vite": "4.3.3",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"autoprefixer": "^10.5.4",
		"cssnano": "^8.0.2",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"reading-time": "^1.5.0",
		"rehype-unwrap-images": "^1.0.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"wrangler": "^4.123.0"
	}
}
